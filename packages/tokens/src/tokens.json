{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "EyEagle Ultimate DS Web token contract. Figma dimensions are px; generated CSS dimensions use rem.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Plus Jakarta Sans",
        "$description": "Primary EyEagle product typeface. Maps to the Figma Web sans family variable."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Standard body weight."
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Metadata and supporting emphasis weight."
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Web headings, navigation, and buttons."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Hero display and eyebrow emphasis weight."
      }
    }
  },
  "type": {
    "display": {
      "hero": {
        "font-size": { "$type": "dimension", "$value": "64px", "$description": "Web Display Hero size." },
        "line-height": { "$type": "dimension", "$value": "68px", "$description": "Web Display Hero line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/bold}", "$description": "Web Display Hero weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-2%", "$description": "Web Display Hero tracking." }
      }
    },
    "heading": {
      "h1": {
        "font-size": { "$type": "dimension", "$value": "36px", "$description": "Web Heading H1 size." },
        "line-height": { "$type": "dimension", "$value": "44px", "$description": "Web Heading H1 line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web Heading H1 weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1.2%", "$description": "Web Heading H1 tracking." }
      },
      "h2": {
        "font-size": { "$type": "dimension", "$value": "28px", "$description": "Web Heading H2 size." },
        "line-height": { "$type": "dimension", "$value": "36px", "$description": "Web Heading H2 line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web Heading H2 weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1.2%", "$description": "Web Heading H2 tracking." }
      },
      "h3": {
        "font-size": { "$type": "dimension", "$value": "20px", "$description": "Web Heading H3 size." },
        "line-height": { "$type": "dimension", "$value": "28px", "$description": "Web Heading H3 line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web Heading H3 weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1.5%", "$description": "Web Heading H3 tracking." }
      },
      "h4": {
        "font-size": { "$type": "dimension", "$value": "16px", "$description": "Web Heading H4 size." },
        "line-height": { "$type": "dimension", "$value": "24px", "$description": "Web Heading H4 line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web Heading H4 weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1.5%", "$description": "Web Heading H4 tracking." }
      }
    },
    "body": {
      "large": {
        "font-size": { "$type": "dimension", "$value": "18px", "$description": "Web Body Large size." },
        "line-height": { "$type": "dimension", "$value": "28px", "$description": "Web Body Large line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/regular}", "$description": "Web Body Large weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1%", "$description": "Web Body Large tracking." }
      },
      "default": {
        "font-size": { "$type": "dimension", "$value": "16px", "$description": "Web Body Default size." },
        "line-height": { "$type": "dimension", "$value": "24px", "$description": "Web Body Default line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/regular}", "$description": "Web Body Default weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1%", "$description": "Web Body Default tracking." }
      },
      "small": {
        "font-size": { "$type": "dimension", "$value": "14px", "$description": "Web Body Small size." },
        "line-height": { "$type": "dimension", "$value": "20px", "$description": "Web Body Small line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/regular}", "$description": "Web Body Small weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1%", "$description": "Web Body Small tracking." }
      }
    },
    "label": {
      "nav": {
        "font-size": { "$type": "dimension", "$value": "14px", "$description": "Web navigation label size." },
        "line-height": { "$type": "dimension", "$value": "20px", "$description": "Web navigation label line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web navigation label weight." },
        "letter-spacing": { "$type": "dimension", "$value": "3%", "$description": "Web navigation label tracking." }
      },
      "default": {
        "font-size": { "$type": "dimension", "$value": "14px", "$description": "Web default label size." },
        "line-height": { "$type": "dimension", "$value": "20px", "$description": "Web default label line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web default label weight." },
        "letter-spacing": { "$type": "dimension", "$value": "3%", "$description": "Web default label tracking." }
      },
      "eyebrow": {
        "font-size": { "$type": "dimension", "$value": "12px", "$description": "Web eyebrow label size." },
        "line-height": { "$type": "dimension", "$value": "16px", "$description": "Web eyebrow line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/bold}", "$description": "Web eyebrow label weight." },
        "letter-spacing": { "$type": "dimension", "$value": "4%", "$description": "Web eyebrow label tracking." }
      }
    },
    "button": {
      "medium": {
        "font-size": { "$type": "dimension", "$value": "16px", "$description": "Web medium button size." },
        "line-height": { "$type": "dimension", "$value": "24px", "$description": "Web medium button line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/semibold}", "$description": "Web medium button weight." },
        "letter-spacing": { "$type": "dimension", "$value": "2%", "$description": "Web medium button tracking." }
      }
    },
    "caption": {
      "metadata": {
        "font-size": { "$type": "dimension", "$value": "12px", "$description": "Web metadata caption size." },
        "line-height": { "$type": "dimension", "$value": "16px", "$description": "Web metadata caption line height." },
        "font-weight": { "$type": "fontWeight", "$value": "{font/weight/medium}", "$description": "Web metadata caption weight." },
        "letter-spacing": { "$type": "dimension", "$value": "-1%", "$description": "Web metadata caption tracking." }
      }
    }
  },
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "Neutral white primitive." },
      "400": { "$type": "color", "$value": "#a2a2a2", "$description": "Neutral disabled primitive." },
      "600": { "$type": "color", "$value": "#737373", "$description": "Neutral tertiary text primitive." },
      "700": { "$type": "color", "$value": "#525252", "$description": "Neutral secondary text primitive." },
      "900": { "$type": "color", "$value": "#262626", "$description": "Neutral primary text primitive." },
      "950": { "$type": "color", "$value": "#111111", "$description": "Deep neutral primitive." }
    },
    "red": {
      "50": { "$type": "color", "$value": "#fbebeb", "$description": "Soft brand red primitive." },
      "700": { "$type": "color", "$value": "#cc0000", "$description": "EyEagle primary brand red." },
      "800": { "$type": "color", "$value": "#8f0000", "$description": "EyEagle pressed and hover red." }
    },
    "warm-neutral": {
      "50": { "$type": "color", "$value": "#f6f4f2", "$description": "Primary warm page surface." },
      "100": { "$type": "color", "$value": "#f4f2ee", "$description": "Warm content surface." }
    },
    "navy": {
      "900": { "$type": "color", "$value": "#111827", "$description": "Dark section surface." }
    },
    "black": { "$type": "color", "$value": "#000000", "$description": "True black for intentional hero or footer surfaces." },
    "text": {
      "$description": "Semantic text roles used by product surfaces.",
      "default": { "$type": "color", "$value": "{color/neutral/900}", "$description": "Primary text on light surfaces." },
      "subtle": { "$type": "color", "$value": "{color/neutral/700}", "$description": "Secondary text and descriptions." },
      "subtlest": { "$type": "color", "$value": "{color/neutral/600}", "$description": "Muted labels and metadata." },
      "disabled": { "$type": "color", "$value": "{color/neutral/400}", "$description": "Disabled text." },
      "inverse": { "$type": "color", "$value": "{color/neutral/0}", "$description": "Text on dark or image surfaces." },
      "brand": { "$type": "color", "$value": "{color/red/700}", "$description": "Brand emphasis text." }
    },
    "bg": {
      "default": { "$type": "color", "$value": "{color/neutral/0}", "$description": "Default white page surface." },
      "page": { "$type": "color", "$value": "{color/warm-neutral/50}", "$description": "Primary warm page background." },
      "warm": { "$type": "color", "$value": "{color/warm-neutral/100}", "$description": "Warm card or content surface." },
      "dark": { "$type": "color", "$value": "{color/navy/900}", "$description": "Dark branded section surface." },
      "black": { "$type": "color", "$value": "{color/black}", "$description": "True black surface." },
      "brand": { "$type": "color", "$value": "{color/red/700}", "$description": "Primary brand surface." },
      "brand-soft": { "$type": "color", "$value": "{color/red/50}", "$description": "Soft brand surface." }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#e4e4e4", "$description": "Subtle divider and card border." },
      "input": { "$type": "color", "$value": "#9c9c9c", "$description": "Input border." },
      "focus": { "$type": "color", "$value": "{color/red/700}", "$description": "Keyboard focus ring." }
    },
    "status": {
      "error": { "$type": "color", "$value": "#dc3545", "$description": "Error state." },
      "success": { "$type": "color", "$value": "#15803d", "$description": "Success state." }
    },
    "overlay": {
      "dark": { "$type": "color", "$value": "rgba(0, 0, 0, 0.24)", "$description": "Dark image or glass overlay." },
      "light": { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)", "$description": "Light ghost or glass overlay." }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px", "$description": "No space." },
    "2": { "$type": "dimension", "$value": "2px", "$description": "Hairline spacing." },
    "4": { "$type": "dimension", "$value": "4px", "$description": "Smallest layout increment." },
    "8": { "$type": "dimension", "$value": "8px", "$description": "Small gap." },
    "12": { "$type": "dimension", "$value": "12px", "$description": "Compact gap." },
    "16": { "$type": "dimension", "$value": "16px", "$description": "Default gap." },
    "20": { "$type": "dimension", "$value": "20px", "$description": "Medium content gap." },
    "24": { "$type": "dimension", "$value": "24px", "$description": "Large component gap." },
    "32": { "$type": "dimension", "$value": "32px", "$description": "Large stack gap." },
    "40": { "$type": "dimension", "$value": "40px", "$description": "Large inset." },
    "48": { "$type": "dimension", "$value": "48px", "$description": "Extra-large stack gap." },
    "56": { "$type": "dimension", "$value": "56px", "$description": "Small section spacing." },
    "80": { "$type": "dimension", "$value": "80px", "$description": "Medium section spacing." },
    "120": { "$type": "dimension", "$value": "120px", "$description": "Desktop container inset." },
    "160": { "$type": "dimension", "$value": "160px", "$description": "Extra-large section spacing." },
    "stack": {
      "2xs": { "$type": "dimension", "$value": "{space/4}", "$description": "Semantic stack 2xs." },
      "xs": { "$type": "dimension", "$value": "{space/8}", "$description": "Semantic stack xs." },
      "sm": { "$type": "dimension", "$value": "{space/12}", "$description": "Semantic stack sm." },
      "md": { "$type": "dimension", "$value": "{space/16}", "$description": "Semantic stack md." },
      "lg": { "$type": "dimension", "$value": "{space/24}", "$description": "Semantic stack lg." },
      "xl": { "$type": "dimension", "$value": "{space/32}", "$description": "Semantic stack xl." },
      "2xl": { "$type": "dimension", "$value": "{space/48}", "$description": "Semantic stack 2xl." }
    },
    "section": {
      "sm": { "$type": "dimension", "$value": "{space/56}", "$description": "Compact marketing section spacing." },
      "md": { "$type": "dimension", "$value": "{space/80}", "$description": "Default marketing section spacing." }
    },
    "container": {
      "x": { "$type": "dimension", "$value": "{space/120}", "$description": "Desktop horizontal container inset." }
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Square corners." },
    "sm": { "$type": "dimension", "$value": "12px", "$description": "Small rounded control or surface." },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Default control radius." },
    "lg": { "$type": "dimension", "$value": "20px", "$description": "Card radius." },
    "xl": { "$type": "dimension", "$value": "32px", "$description": "Large panel or image radius." },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Pill radius." }
  },
  "size": {
    "icon": {
      "sm": { "$type": "dimension", "$value": "16px", "$description": "Small icon." },
      "md": { "$type": "dimension", "$value": "20px", "$description": "Default icon." },
      "lg": { "$type": "dimension", "$value": "24px", "$description": "Large icon." }
    },
    "control": {
      "sm": { "$type": "dimension", "$value": "36px", "$description": "Small control." },
      "md": { "$type": "dimension", "$value": "44px", "$description": "Default interactive control." },
      "lg": { "$type": "dimension", "$value": "48px", "$description": "Large interactive control." }
    },
    "touch": {
      "min": { "$type": "dimension", "$value": "44px", "$description": "Minimum touch target." }
    },
    "container": {
      "max": { "$type": "dimension", "$value": "1200px", "$description": "Marketing content max width." }
    }
  },
  "elevation": {
    "soft": { "$type": "shadow", "$value": "0 4px 16px rgba(0, 0, 0, 0.06)", "$description": "Subtle depth for low-emphasis surfaces." },
    "card": { "$type": "shadow", "$value": "0 8px 24px rgba(17, 24, 39, 0.08)", "$description": "Default card depth." },
    "raised": { "$type": "shadow", "$value": "0 20px 48px rgba(17, 24, 39, 0.10), 0 4px 14px rgba(17, 24, 39, 0.05)", "$description": "Raised panel or glass card depth." },
    "image": { "$type": "shadow", "$value": "0 16px 40px rgba(17, 24, 39, 0.12), 0 2px 8px rgba(17, 24, 39, 0.05)", "$description": "Image frame depth." },
    "nav": { "$type": "shadow", "$value": "0 6px 20px rgba(0, 0, 0, 0.06)", "$description": "Navigation surface depth." }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$description": "Small control transitions." },
      "base": { "$type": "duration", "$value": "220ms", "$description": "Default interface transition." },
      "reveal": { "$type": "duration", "$value": "700ms", "$description": "Subtle section reveal." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "Standard EyEagle easing." }
    }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.5, "$description": "Disabled content opacity." },
    "muted": { "$type": "number", "$value": 0.7, "$description": "Muted content opacity." },
    "overlay": { "$type": "number", "$value": 0.24, "$description": "Default overlay opacity." }
  }
}
